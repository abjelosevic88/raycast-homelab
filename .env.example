# Homelab for Raycast — env file
#
# Copy to ~/.config/raycast-homelab/.env (or point the "Env File" preference elsewhere).
# Every key here has a matching field in Raycast → Extensions → Homelab; a value set
# in the Raycast UI always wins over this file. Leave a service out to hide it.
#
# Generated from package.json by: npm run gen:env

# Glances URL  (e.g. https://glances.example.com)
# Base URL of your Glances instance. Leave empty to hide Glances features.
GLANCES_URL=

# Extra Mount Point  (e.g. /mnt/storage)
# A second filesystem from Glances to show next to / (e.g. a data SSD). Leave empty to show only the root filesystem.
STORAGE_MOUNT=

# Temperatures JSON URL  (e.g. https://home.example.com/images/temps.json)
# Optional URL of a temps.json published by the companion temps-publish script (server CPU/disk + NAS disk temps).
TEMPS_URL=

# Dashboard URL  (e.g. https://home.example.com)
# Optional link to your dashboard (Homepage, Dashy…) shown in the menu bar and Home links.
HOMEPAGE_URL=

# TrueNAS URL  (e.g. https://nas.example.com)
# Base URL of your TrueNAS instance. Leave empty to hide TrueNAS features.
TRUENAS_URL=

# TrueNAS API Key (secret)
# Read-only key is enough (pool capacity + health). Leave empty to hide the NAS row.
TRUENAS_API_KEY=

# qBittorrent URL  (e.g. https://qbit.example.com)
# Base URL of your qBittorrent instance. Leave empty to hide qBittorrent features.
QBIT_URL=

# qBittorrent Username  (e.g. admin)
# Web UI username.
QBIT_USERNAME=

# qBittorrent Password (secret)
# Web UI password. Never attempted while empty (qBittorrent IP-bans after 5 failures).
QBIT_PASSWORD=

# SABnzbd URL  (e.g. https://sabnzbd.example.com)
# Base URL of your SABnzbd instance. Leave empty to hide SABnzbd features.
SABNZBD_URL=

# SABnzbd API Key (secret)
# Config → General → API Key.
SABNZBD_API_KEY=

# slskd URL  (e.g. https://slskd.example.com)
# Base URL of your slskd instance. Leave empty to hide slskd features.
SLSKD_URL=

# slskd API Key (secret)
# Options → Web → Authentication → API keys.
SLSKD_API_KEY=

# Jellyfin URL  (e.g. https://jellyfin.example.com)
# Base URL of your Jellyfin instance. Leave empty to hide Jellyfin features.
JELLYFIN_URL=

# Jellyfin API Key (secret)
# Dashboard → API Keys.
JELLYFIN_API_KEY=

# Jellyfin User ID  (e.g. e.g. 3f1c…)
# Optional. Whose Continue Watching / Next Up to show; defaults to the first administrator.
JELLYFIN_USER_ID=

# Jellyseerr URL  (e.g. https://requests.example.com)
# Base URL of your Jellyseerr instance. Leave empty to hide Jellyseerr features.
JELLYSEERR_URL=

# Jellyseerr API Key (secret)
# Settings → General → API Key (admin).
JELLYSEERR_API_KEY=

# Radarr URL  (e.g. https://radarr.example.com)
# Base URL of your Radarr instance. Leave empty to hide Radarr features.
RADARR_URL=

# Radarr API Key (secret)
# Settings → General.
RADARR_API_KEY=

# Sonarr URL  (e.g. https://sonarr.example.com)
# Base URL of your Sonarr instance. Leave empty to hide Sonarr features.
SONARR_URL=

# Sonarr API Key (secret)
# Settings → General.
SONARR_API_KEY=

# Lidarr URL  (e.g. https://lidarr.example.com)
# Base URL of your Lidarr instance. Leave empty to hide Lidarr features.
LIDARR_URL=

# Lidarr API Key (secret)
# Settings → General.
LIDARR_API_KEY=

# Chaptarr / Readarr URL  (e.g. https://chaptarr.example.com)
# Base URL of your Chaptarr / Readarr instance. Leave empty to hide Chaptarr / Readarr features.
CHAPTARR_URL=

# Chaptarr / Readarr API Key (secret)
# Settings → General (any Readarr-compatible fork).
CHAPTARR_API_KEY=

# Prowlarr URL  (e.g. https://prowlarr.example.com)
# Base URL of your Prowlarr instance. Leave empty to hide Prowlarr features.
PROWLARR_URL=

# Prowlarr API Key (secret)
# Settings → General.
PROWLARR_API_KEY=

# Bazarr URL  (e.g. https://bazarr.example.com)
# Base URL of your Bazarr instance. Leave empty to hide Bazarr features.
BAZARR_URL=

# Bazarr API Key (secret)
# Settings → General.
BAZARR_API_KEY=

# Subtitle Sync Server URL  (e.g. https://subtitles.example.com)
# Base URL of your Subtitle Sync Server instance. Leave empty to hide Subtitle Sync Server features.
SUBSYNC_URL=

# Audiobookshelf URL  (e.g. https://audiobooks.example.com)
# Base URL of your Audiobookshelf instance. Leave empty to hide Audiobookshelf features.
ABS_URL=

# Audiobookshelf API Token (secret)
# Settings → Users → your user → API token.
ABS_TOKEN=

# Navidrome URL  (e.g. https://music.example.com)
# Base URL of your Navidrome instance. Leave empty to hide Navidrome features.
NAVIDROME_URL=

# Navidrome Username  (e.g. admin)
# Any user; Subsonic token auth is used.
NAVIDROME_USER=

# Navidrome Password (secret)
# Password of that user.
NAVIDROME_PASSWORD=

# Immich URL  (e.g. https://immich.example.com)
# Base URL of your Immich instance. Leave empty to hide Immich features.
IMMICH_URL=

# Immich API Key (secret)
# Account Settings → API Keys.
IMMICH_API_KEY=

# Calibre-Web URL  (e.g. https://reader.example.com)
# Base URL of your Calibre-Web instance. Leave empty to hide Calibre-Web features.
CALIBRE_URL=

# Calibre-Web Username  (e.g. admin)
# Used for OPDS + Send-to-Kindle.
CALIBRE_USER=

# Calibre-Web Password (secret)
# Password of that user.
CALIBRE_PASSWORD=

# Paperless URL  (e.g. https://paperless.example.com)
# Base URL of your Paperless-ngx instance. Leave empty to hide Paperless features.
PAPERLESS_URL=

# Paperless API Token (secret)
# Your Paperless profile → API Auth Token. Documents must be visible to this user.
PAPERLESS_TOKEN=

# MeTube URL  (e.g. https://metube.example.com)
# Base URL of your MeTube instance. Leave empty to hide MeTube features.
METUBE_URL=

# MeTube Destinations  (e.g. music|Music,clips|Clips|video)
# Comma-separated extra folders as folder|Label[|video]. Add |video to download video instead of opus audio. Example: music|Music,clips|Clips|video
METUBE_FOLDERS=

# Uptime Kuma URL  (e.g. https://kuma.example.com)
# Base URL of your Uptime Kuma instance. Leave empty to hide Uptime Kuma features.
KUMA_URL=

# Uptime Kuma Status Page Slug  (e.g. home)
# Slug of a public status page (used when no API key is set).
KUMA_STATUS_SLUG=

# Uptime Kuma API Key (secret)
# Settings → API Keys. With a key every monitor is read from /metrics, not just the status page.
KUMA_API_KEY=

# ntfy URL  (e.g. https://ntfy.example.com)
# Base URL of your ntfy instance. Leave empty to hide ntfy features.
NTFY_URL=

# ntfy Topics  (e.g. alerts,downloads)
# Comma-separated topics to read.
NTFY_TOPICS=

# AdGuard Home URL  (e.g. https://dns.example.com)
# Base URL of your AdGuard Home instance. Leave empty to hide AdGuard Home features.
ADGUARD_URL=

# AdGuard Home Username  (e.g. admin)
# Web UI username.
ADGUARD_USERNAME=

# AdGuard Home Password (secret)
# Web UI password.
ADGUARD_PASSWORD=

# Komodo URL  (e.g. https://komodo.example.com)
# Base URL of your Komodo instance. Leave empty to hide Komodo features.
KOMODO_URL=

# Komodo API Key (secret)
# Settings → Profile → API keys.
KOMODO_API_KEY=

# Komodo API Secret (secret)
# Shown once when the key is created.
KOMODO_API_SECRET=

# Backrest URL  (e.g. https://backrest.example.com)
# Base URL of your Backrest instance. Leave empty to hide Backrest features.
BACKREST_URL=

# Backrest Username  (e.g. admin)
# Web UI username.
BACKREST_USERNAME=

# Backrest Password (secret)
# Web UI password.
BACKREST_PASSWORD=

# Scrutiny URL  (e.g. https://scrutiny.example.com)
# Base URL of your Scrutiny instance. Leave empty to hide Scrutiny features.
SCRUTINY_URL=

# Speedtest Tracker URL  (e.g. https://speedtest.example.com)
# Base URL of your Speedtest Tracker instance. Leave empty to hide Speedtest Tracker features.
SPEEDTEST_URL=

# Firefly III URL  (e.g. https://firefly.example.com)
# Base URL of your Firefly III instance. Leave empty to hide Firefly III features.
FIREFLY_URL=

# Firefly III Personal Access Token (secret)
# Options → Profile → OAuth → Personal Access Tokens.
FIREFLY_TOKEN=

# Firefly Pico URL  (e.g. https://pico.example.com)
# Base URL of your Firefly Pico instance. Leave empty to hide Firefly Pico features.
PICO_URL=

# Subscriptions JSON URL  (e.g. https://home.example.com/images/subscriptions.json)
# Optional URL of a subscriptions.json published by the companion firefly-sub-publish script (upcoming bills summary).
SUBSCRIPTIONS_URL=

# Forgejo / Gitea URL  (e.g. https://git.example.com)
# Base URL of your Forgejo / Gitea instance. Leave empty to hide Forgejo / Gitea features.
FORGEJO_URL=

# Nextcloud URL
# Base URL of Nextcloud, including its subpath if any.
NEXTCLOUD_URL=

# Nextcloud Username
# Your Nextcloud user ID (not display name).
NEXTCLOUD_USERNAME=

# Nextcloud App Password (secret)
# Create an app password in Nextcloud → Personal settings → Security.
NEXTCLOUD_APP_PASSWORD=
